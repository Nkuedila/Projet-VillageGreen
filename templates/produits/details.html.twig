{% extends 'base.html.twig' %}

{% block title %}Détails de {{ produit.nom }}{% endblock %}

{% block body %}
    <main class="background-cotainer" style="background-image: url('{{ asset('uploads/bgb.jpeg') }}')">
        <section class="container_1 my-3">
            <div class="neumorphic neumorphic-card">
                <h1>{{ produit.nom }}</h1>        
           
               <div class="col-6">
                   <img src="{{ asset('uploads/produits/' ~ produit.image) }}" alt="image" style="width:45%">
               </div>    
   
               <div class=" col-12 col-sm-6 col-md-4 mb-4">
                <p> {{ produit.description }} </p>
               <p>Catégorie : {{ produit.categories.nom}} </p>
               <p>Prix : {{ produit.prix / 100 }} € </p>
               <p>Stock: {{ produit.stock }}
               {% if produit.stock > 0 %}
                   <a href=" {{ path('cart_add', {id: produit.id}) }} " class="btn btn-success">Ajouter au panier</a>
                   
               {% else %}
   
                   <p class="text-danger"> Temporairement en rupture de stock</p>
                   
                   
               {% endif %}
           </div>
        </div>

               
       </section>
   </main>

{% endblock %}
