<div class="col-12 col-sm-6 col-md-4 col-lg-3 d-flex justify-content-center mb-4 product-wrapper">
    <a href="/categories/slug/{{category.slug}}">
        <div class="product-card">
            <img src="{{ asset('uploads/categories/sous/' ~ category.image) }}" alt="{{ category.nom }}" class="img-fluid">
            <h3>{{ category.nom }}</h3>
        </div>
    </a>
</div>
