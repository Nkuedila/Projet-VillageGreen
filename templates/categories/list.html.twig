{% extends 'base.html.twig' %}

{% block title %}
    Liste des produits de la catégories {{ category.nom }}
    
{% endblock %}

{% block body %}
<main class="background-cotainer" style="background-image: url('{{ asset('uploads/bgb.jpeg') }}')">
    <section class="row">
        <div class="col-12">
            <h1 class="text-primary fw-bold">Liste des produits de la catégorie {{ category.nom }} </h1>
        </div class="plaaaf">

        {% for produit in produits %}
            <div class=" col-lg-3 col-md-4 col-sm-6 col-12 d-flex justify-content-center mb-4 product-wrapper">
                <article class="card h-100">
                    <div class="card-body">
                        <h2 class="card-title">{{ produit.nom }}</h2>
                        <img class="card-img-top" src="{{ asset('uploads/produits/' ~ produit.image) }}" alt="{{ category.nom }}" style="width:100%">
                        <p class="card-text"> {{ produit.description }} </p>
                         <a href="{{ path('produits_details', {'slug': produit.slug  })}}" class="btn btn-primary"> Voir les details</a>
                     </div>
                </article>
            </div>
            
        {% endfor %}
        </div>
    </section>
</main>

{% endblock %}