<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %} 🛍️ Village_Green{% endblock %}</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        <script src="{{ asset('js/app.js') }}"></script>
        

          {% block stylesheets %}
        {% endblock %}
        
    </head>
    <body>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        {% include "_partials/_nav.html.twig" %} 

        <!-- Hero Section with Search Bar -->
        <section class="hero-section position-relative text-center">
            <img src="{{ asset('uploads/bgali.jpg') }}" alt="Background Image" class="img-fluid w-100" style="height: 500px;">
            <div class="position-absolute top-50 start-50 translate-middle" style="width: 40%;">
                <form method="get" action="{{ path('produits_recherche') }}">
                    <input class="form-control" type="search" name="search" placeholder="Search for produits..." aria-label="Search">
                </form>
            </div>
        </section>

        {% include "_partials/_flash.html.twig" %}

       

        {% block body %}{% endblock %}

        {% include "_partials/_footer.html.twig" %}
    </body>
</html>
